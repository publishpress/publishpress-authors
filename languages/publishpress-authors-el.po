#: src/core/Mcp/Objects.php:228
msgid "Native object not found."
msgstr "Το εγγενές αντικείμενο δεν βρέθηκε."

#: src/core/Mcp/Objects.php:250
msgid "This object changed. Read it again before editing."
msgstr "Αυτό το αντικείμενο άλλαξε. Διαβάστε το ξανά πριν την επεξεργασία."

#: src/core/Mcp/Objects.php:253
msgid "A title is required for a new object."
msgstr "Ένας τίτλος είναι υποχρεωτικός για ένα νέο αντικείμενο."

#: src/core/Mcp/Objects.php:257
msgid "You cannot create or publish this native object."
msgstr "Δεν μπορείτε να δημιουργήσετε ή να δημοσιεύσετε αυτό το εγγενές αντικείμενο."

#: src/core/Mcp/Objects.php:261
msgid "This field name is reserved for account identity or security."
msgstr ""
"Αυτό το όνομα πεδίου είναι κατειλημμένο για την ταυτότητα λογαριασμού ή την "
"ασφάλεια."

#: src/core/Mcp/Objects.php:266
msgid "Choose a unique author field slug."
msgstr "Επιλέξτε ένα μοναδικό slug πεδίου συγγραφέα."

#: src/core/Mcp/Objects.php:270
msgid "Choose discovered profile field names for the box order."
msgstr "Επιλέξτε ανακαλυφθέντα ονόματα πεδίου προφίλ για τη σειρά σκηνών."

#: src/core/Mcp/Objects.php:280
msgid "Choose a discovered template when creating a new Author Box."
msgstr ""
"Επιλέξτε ένα ανακαλυφθέν πρότυπο κατά τη δημιουργία μιας νέας Σκηνής "
"Συγγραφέα."

#: src/core/Mcp/Objects.php:325
msgid "The field order could not be saved. Read the object before retrying."
msgstr ""
"Η σειρά πεδίων δεν μπόρεσε να αποθηκευτεί. Διαβάστε το αντικείμενο πριν "
"δοκιμάσετε ξανά."

#: src/core/Mcp/Objects.php:333
msgid "Native metadata save failed; the original object was restored."
msgstr ""
"Η αποθήκευση εγγενών μεταδεδομένων απέτυχε· το αρχικό αντικείμενο "
"αποκαταστάθηκε."

#: src/core/Mcp/Objects.php:334
msgid ""
"Native metadata save failed and the original object could not be fully "
"restored. Read it before retrying."
msgstr ""
"Η αποθήκευση εγγενών μεταδεδομένων απέτυχε και το αρχικό αντικείμενο δεν "
"μπόρεσε να αποκατασταθεί πλήρως. Διαβάστε το πριν δοκιμάσετε ξανά."

#: src/core/Mcp/Objects.php:370
msgid "This object changed. Read it again before deleting."
msgstr "Αυτό το αντικείμενο άλλαξε. Διαβάστε το ξανά πριν τη διαγραφή."

#: src/core/Mcp/Objects.php:373
msgid "You cannot trash this object, or Trash is disabled."
msgstr ""
"Δεν μπορείτε να διαγράψετε αυτό το αντικείμενο, ή η Διαγραφή είναι "
"απενεργοποιημένη."

#: src/core/Mcp/Objects.php:376
msgid "The native object could not be trashed."
msgstr "Το εγγενές αντικείμενο δεν μπόρεσε να διαγραφεί."

#: src/core/Mcp/Profiles.php:23
msgid "Discover author profile fields"
msgstr "Ανακαλύψτε πεδία προφίλ συγγραφέα"

#: src/core/Mcp/Profiles.php:24
msgid ""
"Read native field labels, types and choices for an author. Enabled custom "
"fields are included. Email, account identity, passwords and privileged user "
"fields are excluded from profile fields; account linking has a separate "
"action."
msgstr ""
"Ανάγνωση ετικετών πεδίου, τύπων και επιλογών για έναν συγγραφέα. "
"Περιλαμβάνονται τα ενεργοποιημένα προσαρμοσμένα πεδία. Τα email, η "
"ταυτότητα λογαριασμού, οι κωδικοί πρόσβασης και τα πεδία προνομιακών "
"χρηστών εξαιρούνται από τα πεδία προφίλ· η σύνδεση λογαριασμού έχει "
"ξεχωριστή ενέργεια."

#: src/core/Mcp/Profiles.php:32
msgid "Read author profile details"
msgstr "Ανάγνωση λεπτομερειών προφίλ συγγραφέα"

#: src/core/Mcp/Profiles.php:33
msgid ""
"Read an author profile, public native field values and a revision hash. "
"Hidden REST fields, emails and arbitrary metadata are excluded. Use "
"get-profile-fields before editing and the latest hash to update."
msgstr ""
"Ανάγνωση ενός προφίλ συγγραφέα, δημόσιες εγγενείς τιμές πεδίου και έναν "
"αναγνωριστικό αναθεώρησης. Κρυφά REST πεδία, email και αυθαίρετα "
"μεταδεδομένα εξαιρούνται. Χρησιμοποιήστε το get-profile-fields πριν την "
"επεξεργασία και τον τελευταίο αναγνωριστικό για την ενημέρωση."

#: src/core/Mcp/Profiles.php:41
msgid "Create or update author profile"
msgstr "Δημιουργία ή ενημέρωση προφίλ συγγραφέα"

#: src/core/Mcp/Profiles.php:42
msgid ""
"Create a guest author, create a profile linked to an existing user_id, or "
"patch an existing profile. Guest creation must be enabled. Discover native "
"fields first; update requires expected_hash. Preserves omitted fields and "
"respects linked-user permissions and administrator profile locks. dry_run "
"validates without saving. Does not create WordPress accounts."
msgstr ""
"Δημιουργήστε έναν συγγραφέα επισκέπτη, δημιουργήστε ένα προφίλ συνδεδεμένο "
"με έναν υπάρχοντα user_id ή διορθώστε ένα υπάρχον προφίλ. Η δημιουργία "
"επισκέπτη πρέπει να είναι ενεργοποιημένη. Ανακαλύψτε πρώτα τα εγγενή πεδία. "
"Η ενημέρωση απαιτεί expected_hash. Διατηρεί τα παραλειπόμενα πεδία και "
"σέβεται τις άδειες του συνδεδεμένου χρήστη και τους περιορισμούς του προφίλ "
"του διαχειριστή. Το dry_run επικυρώνει χωρίς αποθήκευση. Δεν δημιουργεί "
"λογαριασμούς WordPress."

#: src/core/Mcp/Profiles.php:58
msgid "Link or unlink an author user account"
msgstr "Συνδέστε ή αποσυνδέστε έναν λογαριασμό συγγραφέα χρήστη"

#: src/core/Mcp/Profiles.php:59
msgid ""
"Link an existing author to an existing WordPress user, or use user_id 0 to "
"unlink without deleting or changing the account. Requires the latest "
"profile hash, edit_user on linked accounts, native mapping restrictions and "
"administrator profile policy. dry_run previews without saving."
msgstr ""
"Συνδέστε έναν υπάρχοντα συγγραφέα με έναν υπάρχοντα χρήστη WordPress ή "
"χρησιμοποιήστε το user_id 0 για να αποσυνδέσετε χωρίς να διαγράψετε ή να "
"αλλάξετε τον λογαριασμό. Απαιτεί τον τελευταίο hash προφίλ, edit_user σε "
"συνδεδεμένους λογαριασμούς, περιορισμούς εγγενούς χαρτογράφησης και "
"πολιτική προφίλ διαχειριστή. Το dry_run προεπισκοπεί χωρίς αποθήκευση."

#: src/core/Mcp/Profiles.php:68
