msgid "It looks like you have Co-Authors Plus installed."
msgstr "Il semble que vous ayez Co-Authors Plus installé."

#: src/modules/multiple-authors/multiple-authors.php:5197
msgid "Please click here and read this guide!"
msgstr "Veuillez cliquer ici et lire ce guide !"

