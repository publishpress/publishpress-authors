msgstr "Daftar Penulis memerlukan judul dan tata letak asli."

#: src/core/Mcp/Lists.php:197
msgid "The Author List changed. Read it again before deleting."
msgstr "Daftar Penulis telah berubah. Bacalah lagi sebelum menghapus."

