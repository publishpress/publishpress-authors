"Ændringer af forfatter sider opdaterer omskrivningsregler. Pro branding "
"kræver Pro."

#: src/core/Mcp/Settings.php:41
msgid "Discover Authors features and actions"
msgstr "Opdag funktioner og handlinger for forfattere"

#: src/core/Mcp/Settings.php:42
