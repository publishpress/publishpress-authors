msgstr "A Box shortcode-ok karakterlánc értékeket igényelnek."

#: src/core/Mcp/Fields.php:154
msgid "Each box shortcode needs one matching position."
msgstr "Minden box shortcode-hoz egy megfelelő pozíció szükséges."

