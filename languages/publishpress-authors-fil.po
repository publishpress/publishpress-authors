msgstr "Nagbago ang post byline. Basahin ito muli bago mag-save."

#: src/core/Mcp/Bylines.php:172
msgid "Choose existing author term IDs."
msgstr "Pumili ng umiiral na author term IDs."

#: src/core/Mcp/Bylines.php:177
