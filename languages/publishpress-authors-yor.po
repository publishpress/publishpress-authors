"Awọn shortcode apoti nilo awọn atokọ ti o ni ibamu ti shortcode ati awọn "
"okun ipo."

#: src/core/Mcp/Fields.php:149
msgid "Box shortcodes require string values."
msgstr "Awọn shortcode apoti nilo awọn iye okun."

#: src/core/Mcp/Fields.php:154
