msgstr "Reasigna las referencias de categoría antes de eliminar."

#: src/core/Mcp/Categories.php:234
msgid "The category could not be deleted."
msgstr "No se pudo eliminar la categoría."

#: src/core/Mcp/Fields.php:123
msgid "Use the exact native field type shown in discovery."
msgstr "Utiliza el tipo de campo nativo exacto mostrado en la búsqueda."

#: src/core/Mcp/Fields.php:131
msgid "Choose a list of values from field discovery."
msgstr "Elige una lista de valores de la búsqueda de campos."

#: src/core/Mcp/Fields.php:135
msgid "Field choice lists require string values from discovery."
msgstr "Las listas de opciones de campo requieren valores de cadena de la búsqueda."

#: src/core/Mcp/Fields.php:145
msgid "Box shortcodes require parallel lists of shortcode and position strings."
msgstr ""
"Los shortcodes de caja requieren listas paralelas de cadenas de shortcode y "
"posición."

#: src/core/Mcp/Fields.php:149
msgid "Box shortcodes require string values."
msgstr "Los shortcodes de caja requieren valores de cadena."

#: src/core/Mcp/Fields.php:154
msgid "Each box shortcode needs one matching position."
msgstr "Cada shortcode de caja necesita una posición coincidente."

