msgstr "קטגוריית מחבר לא נמצאה."

#: src/core/Mcp/Categories.php:133
msgid "The category changed. Read it again before saving."
msgstr "הקטגוריה השתנתה. קרא אותה שוב לפני שמירה."

#: src/core/Mcp/Categories.php:136
msgid "Use exact category field types from discovery."
msgstr "השתמש בסוגי שדות קטגוריה מדויקים מהגילוי."

#: src/core/Mcp/Categories.php:146
