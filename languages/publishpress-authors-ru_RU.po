msgstr "Этот объект изменился. Прочитайте его снова перед редактированием."

#: src/core/Mcp/Objects.php:253
msgid "A title is required for a new object."
msgstr "Заголовок обязателен для нового объекта."

#: src/core/Mcp/Objects.php:257
